# Gemini API Configuration
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# Logging
LOG_LEVEL=INFO

# Frame Processing (optional - uses defaults if not set)
# MAX_FRAME_WIDTH=512
# MAX_FRAME_HEIGHT=512
# JPEG_QUALITY=70
# SCENE_CHANGE_THRESHOLD=0.15
# STATIC_SCENE_FPS=1.0
# DYNAMIC_SCENE_FPS=2.0

# Session Configuration (optional)
# MAX_SESSION_DURATION_SECONDS=600
# MAX_DAILY_USAGE_SECONDS=1800
